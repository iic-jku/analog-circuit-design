# shellcheck shell=bash

# Switch to IHP SG13CMOS5L PDK if not already set
if [[ "$PDK" != ihp-sg13cmos5l ]]; then
    export PDK=ihp-sg13cmos5l
    export PDKPATH=$PDK_ROOT/$PDK
    export STD_CELL_LIBRARY=sg13cmos5l_stdcell
    export SPICE_USERINIT_DIR=$PDK_ROOT/$PDK/libs.tech/ngspice
fi

# Set path for Xschem
export XSCHEM_USER_LIBRARY_PATH=$DESIGNS/xschem

# The SG13CMOS5L devices used here (e.g., cap_cmomf, cornerPNP.lib) need
# IIC-OSIC-TOOLS version 2026.08 or later
YEARMONTH=${IIC_OSIC_TOOLS_VERSION//./}
if [[ -n "$YEARMONTH" && $YEARMONTH -lt 202608 ]]; then
    echo
    echo "[WARNING] This course requires the IHP SG13CMOS5L PDK as shipped with IIC-OSIC-TOOLS 2026.08 or later!"
    echo "[WARNING] Please update your image."
fi
